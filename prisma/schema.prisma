generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
enum Role{
  ADMIN
  USER
}

model User{
  id Int @id @default(autoincrement())
  name String
  email String @unique
  role Role @default(USER)
  cretedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
